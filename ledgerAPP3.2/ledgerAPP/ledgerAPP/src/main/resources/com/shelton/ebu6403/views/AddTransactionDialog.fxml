<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.DatePicker?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="15" style="-fx-padding: 20; -fx-pref-width: 350;">

    <Label text="Add Transaction" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <DatePicker fx:id="dateField" promptText="Date"/>

    <TextField fx:id="amountField" promptText="Amount"/>

    <TextField fx:id="titleField" promptText="Expense Title"/>

    <TextArea fx:id="descriptionField" promptText="Description" prefRowCount="3"/>

    <ComboBox fx:id="categoryField" promptText="Select Category"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Save" styleClass="dialog-button"/>
        <Button text="Cancel" styleClass="dialog-button"/>
    </HBox>
</VBox>
