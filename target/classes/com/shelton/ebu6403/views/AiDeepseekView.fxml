<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    File: AiDeepseekView.fxml
    Description: User interface layout for the AI Assistant panel, enabling question input and AI response display.
    Controller: com.shelton.ebu6403.controller.AiDeepseekController
    Author: LedgerEase Team
    Last updated: May 2025
-->

<VBox fx:controller="com.shelton.ebu6403.controller.AiDeepseekController"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="aiContainer"
      spacing="15"
      alignment="TOP_CENTER"
      prefWidth="800"
      prefHeight="600"
      style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f7f7f7); -fx-padding: 20;">

    <!-- Title label for AI section -->
    <Label text="AI Helper"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;" />

    <!-- Output area to show AI responses -->
    <TextArea fx:id="outputArea"
              prefHeight="400"
              editable="false"
              wrapText="true"
              style="-fx-background-radius: 10; -fx-font-size: 14px; -fx-control-inner-background: #fcfcfc;
                     -fx-border-color: #ddd; -fx-border-radius: 10;" />

    <!-- Input area for user to type a question and send to AI -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <TextArea fx:id="inputArea"
                  promptText="Please input your question..."
                  prefRowCount="2"
                  wrapText="true"
                  HBox.hgrow="ALWAYS"
                  style="-fx-background-radius: 8; -fx-font-size: 14px; -fx-control-inner-background: #ffffff;
                         -fx-border-color: #007ACC; -fx-border-radius: 8;" />

        <!-- Send button to trigger AI query -->
        <Button fx:id="sendButton"
                text="Send"
                prefWidth="180"
                prefHeight="40"
                style="-fx-background-color: #007ACC; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-background-radius: 6; -fx-font-size: 14px;" />
    </HBox>
</VBox>
