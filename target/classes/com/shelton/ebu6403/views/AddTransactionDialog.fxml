<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    File: AddTransactionDialog.fxml
    Description: Form layout for adding a new financial transaction (expense or income).
    Includes fields for date, amount, title, description, and category.
    Author: LedgerEase Team
    Last updated: May 2025
-->

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="15" style="-fx-padding: 20; -fx-pref-width: 350;">

    <!-- Section title -->
    <Label text="Add Transaction" style="-fx-font-size: 18; -fx-font-weight: bold;" />

    <!-- Date picker for transaction date -->
    <DatePicker fx:id="dateField" promptText="Date" />

    <!-- Input field for transaction amount -->
    <TextField fx:id="amountField" promptText="Amount" />

    <!-- Input field for transaction title (e.g., item or purpose) -->
    <TextField fx:id="titleField" promptText="Expense Title" />

    <!-- Optional description for the transaction -->
    <TextArea fx:id="descriptionField" promptText="Description" prefRowCount="3" />

    <!-- Dropdown menu to select transaction category -->
    <ComboBox fx:id="categoryField" promptText="Select Category" />

    <!-- Action buttons: Save or Cancel -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Save" styleClass="dialog-button" />
        <Button text="Cancel" styleClass="dialog-button" />
    </HBox>
</VBox>
