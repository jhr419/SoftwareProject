<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<!--
    File: Investments.fxml
    Description: Layout for the investments page in LedgerEase. Includes:
                 - Horizontal scrollable card view for bank/investment summaries
                 - Summary analysis and revenue chart
                 - Investment list and AI assistant entry
    Controller: com.shelton.ebu6403.controller.InvestmentsController
    Stylesheet: ../styles/investments.css
    Author: LedgerEase Team
    Last updated: May 2025
-->

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.shelton.ebu6403.controller.InvestmentsController"
            stylesheets="@../styles/investments.css"
            fitToWidth="true">

    <content>
        <BorderPane>

            <!-- Top card + summary + chart section -->
            <top>
                <VBox spacing="20" style="-fx-padding: 20;">

                    <!-- Scrollable card view (e.g., bank cards) -->
                    <ScrollPane fitToHeight="false" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER">
                        <HBox fx:id="cardScrollContainer" spacing="15" styleClass="card-scroll-container" />
                    </ScrollPane>

                    <!-- Date picker for summary filtering -->
                    <DatePicker fx:id="summaryDatePicker"
                                style="-fx-padding: 4; -fx-font-size: 13px; -fx-background-color: white;"
                                promptText="Select a Date" />

                    <HBox spacing="20">
                        <!-- Left: Summary insight cards -->
                        <VBox fx:id="infoSummaryContainer" spacing="15" prefWidth="400" />

                        <!-- Right: Monthly revenue line chart -->
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Monthly Revenue" styleClass="section-title" />
                            <LineChart fx:id="monthlyRevenueChart" title="" prefHeight="350">
                                <xAxis>
                                    <CategoryAxis label="Month" />
                                </xAxis>
                                <yAxis>
                                    <NumberAxis label="Amount" />
                                </yAxis>
                            </LineChart>
                        </VBox>
                    </HBox>
                </VBox>
            </top>

            <!-- Bottom investment + assistant section -->
            <center>
                <HBox spacing="20" style="-fx-padding: 20;">

                    <!-- Investment list with date filter -->
                    <VBox spacing="10">
                        <DatePicker fx:id="investmentDatePicker"
                                    style="-fx-padding: 4; -fx-font-size: 13px; -fx-background-color: white;"
                                    promptText="Select Investment Date"/>

                        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
                            <VBox fx:id="investmentListContainer" spacing="15" />
                        </ScrollPane>
                    </VBox>

                    <!-- AI Assistant card with button -->
                    <VBox fx:id="aiAssistantCard" alignment="CENTER" spacing="15">
                        <Button text="AI+  DEEPSEEK-R1   →" styleClass="ai-assistant-button" onAction="#goToAiPage"/>
                    </VBox>
                </HBox>
            </center>
        </BorderPane>
    </content>
</ScrollPane>
