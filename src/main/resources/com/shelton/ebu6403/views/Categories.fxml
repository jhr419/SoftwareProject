<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!--
    File: Categories.fxml
    Description: Defines the user interface layout for managing expense and income categories.
                 Includes dynamic card displays, transaction tables, and operation buttons.
    Controller: com.shelton.ebu6403.controller.CategoriesController
    Stylesheet: ../styles/categories.css
    Author: LedgerEase Team
    Last updated: May 2025
-->

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.shelton.ebu6403.controller.CategoriesController"
            stylesheets="@../styles/categories.css">

    <!-- Center section: Expense and Income category cards and tables -->
    <center>
        <HBox spacing="20" style="-fx-padding: 0">

            <!-- Expense category section -->
            <VBox spacing="15" styleClass="category-section" HBox.hgrow="ALWAYS">
                <Label text="Expenses" styleClass="section-title"/>

                <!-- Scrollable container for expense cards -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                    <FlowPane fx:id="expensesCardContainer"
                              styleClass="card-container"
                              hgap="15" vgap="15"
                              prefWrapLength="600">
                        <!-- Cards will be generated dynamically by the controller -->
                    </FlowPane>
                </ScrollPane>

                <!-- Expense transaction table -->
                <TableView fx:id="expensesTable" styleClass="transaction-table">
                    <columns>
                        <TableColumn text="SL No" prefWidth="60"/>
                        <TableColumn text="Name" prefWidth="150"/>
                        <TableColumn text="Date" prefWidth="120"/>
                        <TableColumn text="Price" prefWidth="100"/>
                        <TableColumn text="Category" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Income category section -->
            <VBox spacing="15" styleClass="category-section" HBox.hgrow="ALWAYS">
                <Label text="Income" styleClass="section-title"/>

                <!-- Scrollable container for income cards -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                    <FlowPane fx:id="incomeCardContainer"
                              styleClass="card-container"
                              hgap="15" vgap="15"
                              prefWrapLength="600">
                        <!-- Cards will be generated dynamically by the controller -->
                    </FlowPane>
                </ScrollPane>

                <!-- Income transaction table -->
                <TableView fx:id="incomeTable" styleClass="transaction-table">
                    <columns>
                        <TableColumn text="SL No" prefWidth="60"/>
                        <TableColumn text="Name" prefWidth="150"/>
                        <TableColumn text="Date" prefWidth="120"/>
                        <TableColumn text="Amount" prefWidth="100"/>
                        <TableColumn text="Category" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <!-- Bottom action buttons -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 0 20 20 0;">
            <Button text="Import CSV" onAction="#handleImportCSV" styleClass="primary-button"/>
            <Button text="Add Expense" onAction="#showAddExpenseDialog" styleClass="add-button"/>
            <Button text="Add Income" onAction="#showAddIncomeDialog" styleClass="add-button"/>
            <Button text="Delete Expense" onAction="#handleDeleteExpense" styleClass="primary-button"/>
            <Button text="Delete Income" onAction="#handleDeleteIncome" styleClass="primary-button"/>
            <Button text="Edit Income" onAction="#handleEditIncome" styleClass="primary-button"/>
            <Button text="Edit Expense" onAction="#handleEditExpense" styleClass="primary-button"/>
        </HBox>
    </bottom>
</BorderPane>
