<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:controller="com.shelton.ebu6403.controller.AiDeepseekController"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="aiContainer"
      spacing="15"
      alignment="TOP_CENTER"
      prefWidth="800"
      prefHeight="600"
      style="-fx-background-color: linear-gradient(to bottom, #ffffff, #f7f7f7); -fx-padding: 20;">

    <!-- 顶部标题 -->
    <Label text="AI Helper 智能助手"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;" />

    <!-- 输出区域 -->
    <TextArea fx:id="outputArea"
              prefHeight="400"
              editable="false"
              wrapText="true"
              style="-fx-background-radius: 10; -fx-font-size: 14px; -fx-control-inner-background: #fcfcfc;
                     -fx-border-color: #ddd; -fx-border-radius: 10;" />

    <!-- 输入区 + 发送按钮 -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <TextArea fx:id="inputArea"
                  promptText="请输入你的问题..."
                  prefRowCount="2"
                  wrapText="true"
                  HBox.hgrow="ALWAYS"
                  style="-fx-background-radius: 8; -fx-font-size: 14px; -fx-control-inner-background: #ffffff;
                         -fx-border-color: #007ACC; -fx-border-radius: 8;" />

        <Button fx:id="sendButton"
                text="发送"
                prefWidth="180"
                prefHeight="40"
                style="-fx-background-color: #007ACC; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-background-radius: 6; -fx-font-size: 14px;" />
    </HBox>
</VBox>
