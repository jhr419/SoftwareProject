<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!--
    File: home.fxml
    Description: Defines the UI for the home dashboard in LedgerEase.
                 Includes sections for welcome message, daily statistics, weekly activity, recent transactions, card overview, and expense distribution.
    Controller: com.shelton.ebu6403.controller.HomeController
    Stylesheet: ../styles/home.css
    Author: LedgerEase Team
    Last updated: May 2025
-->

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.shelton.ebu6403.controller.HomeController"
            stylesheets="@../styles/home.css">

    <!-- Main content scrollable area -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f5f5f5;" minHeight="-Infinity">

                <!-- Welcome section -->
                <VBox spacing="2" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                    <Label text="Hi, Welcome Back!" styleClass="welcome-title"/>
                    <Label text="Good Morning :)" styleClass="welcome-subtitle"/>
                </VBox>

                <!-- Daily statistics summary -->
                <VBox spacing="10">
                    <Label text="Daily Statistics" styleClass="section-title"/>
                    <HBox spacing="15" styleClass="card-container" HBox.hgrow="ALWAYS">

                        <!-- Food card -->
                        <VBox styleClass="stat-card" spacing="5" prefWidth="200" HBox.hgrow="ALWAYS">
                            <Label text="Food" styleClass="card-category"/>
                            <Label fx:id="foodAmount" text="/$49.20" styleClass="card-amount"/>
                            <Label fx:id="foodUpdate" text="Updated at 17:46 - April 30" styleClass="card-update"/>
                        </VBox>

                        <!-- Transportation card -->
                        <VBox styleClass="stat-card" spacing="5" prefWidth="200" HBox.hgrow="ALWAYS">
                            <Label text="Transportation" styleClass="card-category"/>
                            <Label fx:id="transportAmount" text="/$30.40" styleClass="card-amount"/>
                            <Label fx:id="transportUpdate" text="Updated at 8:27 - April 30" styleClass="card-update"/>
                        </VBox>

                        <!-- Sports card -->
                        <VBox styleClass="stat-card" spacing="5" prefWidth="200" HBox.hgrow="ALWAYS">
                            <Label text="Sports" styleClass="card-category"/>
                            <Label fx:id="sportsAmount" text="/$25.21" styleClass="card-amount"/>
                            <Label fx:id="sportsUpdate" text="Updated at 18:43 - April 30" styleClass="card-update"/>
                        </VBox>

                        <!-- Clothing card -->
                        <VBox styleClass="stat-card" spacing="5" prefWidth="200" HBox.hgrow="ALWAYS">
                            <Label text="Clothing" styleClass="card-category"/>
                            <Label fx:id="clothingAmount" text="/$15.00" styleClass="card-amount"/>
                            <Label fx:id="clothingUpdate" text="Updated at 12:15 - April 30" styleClass="card-update"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Main content grid: weekly chart, transactions, cards, expense pie -->
                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="65"/>
                        <ColumnConstraints percentWidth="35"/>
                    </columnConstraints>

                    <!-- Weekly activity bar chart -->
                    <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Weekly Activity" styleClass="section-title"/>
                        <BarChart fx:id="weeklyChart" title="Weekly Activity">
                            <xAxis>
                                <CategoryAxis fx:id="xAxis">
                                    <categories>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Mon"/>
                                            <String fx:value="Tue"/>
                                            <String fx:value="Wed"/>
                                            <String fx:value="Thu"/>
                                            <String fx:value="Fri"/>
                                            <String fx:value="Sat"/>
                                            <String fx:value="Sun"/>
                                        </FXCollections>
                                    </categories>
                                </CategoryAxis>
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="yAxis" label="Amount ($)"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <!-- Recent transactions list -->
                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Recent Transactions" styleClass="section-title"/>
                        <ListView fx:id="recentTransactions" styleClass="transaction-list" prefHeight="250"/>
                    </VBox>

                    <!-- My Cards summary -->
                    <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="My Cards" styleClass="section-title"/>
                        <HBox spacing="20">
                            <VBox styleClass="bank-card" spacing="10" prefWidth="300">
                                <Label text="3778 **** 1234" styleClass="card-number"/>
                                <Label text="Balance" styleClass="card-label"/>
                                <Label fx:id="card1Balance" text="/$5,756.38" styleClass="card-value"/>
                                <Label text="Card Holder" styleClass="card-label"/>
                                <Label fx:id="card1Holder" text="Eddy Cusuma" styleClass="card-value"/>
                            </VBox>
                            <VBox styleClass="bank-card" spacing="10" prefWidth="300">
                                <Label text="3778 **** 5678" styleClass="card-number"/>
                                <Label text="Balance" styleClass="card-label"/>
                                <Label fx:id="card2Balance" text="/$2,345.67" styleClass="card-value"/>
                                <Label text="Card Holder" styleClass="card-label"/>
                                <Label fx:id="card2Holder" text="Shelton Li" styleClass="card-value"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Expense distribution pie chart -->
                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Expense Statistics" styleClass="section-title"/>
                        <PieChart fx:id="expenseChart" prefHeight="250"/>
                    </VBox>
                </GridPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
