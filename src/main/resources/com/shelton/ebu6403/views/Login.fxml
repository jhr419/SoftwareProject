<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<VBox alignment="CENTER" spacing="20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.shelton.ebu6403.controller.LoginController"
      style="-fx-background-color: #f5f6fa;">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <!-- User Avatar -->
    <ImageView fx:id="avatarView" fitWidth="100" fitHeight="100"/>

    <!-- Title -->
    <Label text="Welcome to LedgerEase" style="-fx-font-weight: bold; -fx-font-size: 24;">
        <font>
            <Font name="Arial"/>
        </font>
    </Label>

    <!-- Username Input -->
    <TextField fx:id="usernameField"
               promptText="Enter username"
               style="-fx-background-radius: 20; -fx-pref-width: 300;"/>

    <!-- Password Input -->
    <!-- Password Input with Visibility Toggle -->
    <HBox spacing="5" alignment="CENTER_LEFT">
        <StackPane>
            <PasswordField fx:id="passwordField"
                           promptText="Enter password"
                           style="-fx-background-radius: 20; -fx-pref-width: 300;" />
            <TextField fx:id="passwordVisibleField"
                       promptText="Enter password"
                       visible="false" managed="false"
                       style="-fx-background-radius: 20; -fx-pref-width: 300;" />
        </StackPane>
        <ImageView fx:id="eyeIcon"
                   fitWidth="20" fitHeight="20"
                   onMouseClicked="#togglePasswordVisibility"
                   pickOnBounds="true"
                   style="-fx-cursor: hand;" />
    </HBox>

    <Label fx:id="loginMessage" text="" style="-fx-text-fill: red;" />

    <!-- Login Button -->
    <Button text="Sign In" onAction="#handleLogin"
            style="-fx-background-color: #3498db;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-background-radius: 20;
                   -fx-pref-width: 300;
                   -fx-pref-height: 40;"/>

    <!-- Fingerprint Section -->
    <VBox alignment="CENTER" spacing="10">
        <Label text="Or use fingerprint"
               style="-fx-text-fill: #7f8c8d; -fx-font-size: 12;"/>
        <ImageView fx:id="fingerprintIcon"
                   fitWidth="48"
                   fitHeight="48"
                   preserveRatio="true"/>
    </VBox>

    <!-- Footer Link -->
    <Hyperlink text="Create new account"
               onAction="#handleCreateAccount"
               style="-fx-text-fill: #3498db; -fx-border-color: transparent;" />

</VBox>


