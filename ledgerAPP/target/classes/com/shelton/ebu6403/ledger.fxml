<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shelton.ebu6403.LedgerController">
    <!-- 左侧导航栏 -->
    <left>
        <VBox spacing="15" alignment="TOP_CENTER" style="-fx-background-color: #2C3E50; -fx-padding: 20px;">
            <!-- 用户头像 -->
            <ImageView fx:id="userAvatar" fitWidth="80" fitHeight="80"/>
            <!-- 用户名 -->
            <Label fx:id="userName" text="用户姓名" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
            <Separator/>

            <!-- 导航按钮 -->
            <Button text="统计" fx:id="btnStatistics" onAction="#switchToStatistics"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>
            <Button text="明细" fx:id="btnDetails" onAction="#switchToDetails"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>
            <Button text="理财" fx:id="btnFinance" onAction="#switchToFinance"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px;"/>
        </VBox>
    </left>

    <!-- 右侧主要内容 -->
    <center>
        <StackPane fx:id="contentPane"/>
    </center>
</BorderPane>


