<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox spacing="10" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shelton.ebu6403.StatisticsController">

    <!-- 账本选择按钮 -->
    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10;">
        <Button text="📖 选择账本" onAction="#openLedgerSelection"/>
    </HBox>

    <!-- 上半部分：支出记录 -->
    <VBox spacing="10" style="-fx-padding: 10;">
        <Label text="📉 支出" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <FlowPane hgap="10" vgap="10">
            <HBox style="-fx-border-color: gray; -fx-border-radius: 5px; -fx-padding: 10;" spacing="10">
                <Label text="🍚 食物" style="-fx-font-size: 14px;"/>
                <Label text="午饭：米饭" style="-fx-text-fill: gray;"/>
                <Label text="-1.00" style="-fx-text-fill: red;"/>
            </HBox>
            <HBox style="-fx-border-color: gray; -fx-border-radius: 5px; -fx-padding: 10;" spacing="10">
                <Label text="🚗 交通" style="-fx-font-size: 14px;"/>
                <Label text="公交车费" style="-fx-text-fill: gray;"/>
                <Label text="-2.50" style="-fx-text-fill: red;"/>
            </HBox>
        </FlowPane>
    </VBox>

    <!-- 下半部分：收入记录 -->
    <VBox spacing="10" style="-fx-padding: 10;">
        <Label text="📈 收入" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <FlowPane hgap="10" vgap="10">
            <HBox style="-fx-border-color: gray; -fx-border-radius: 5px; -fx-padding: 10;" spacing="10">
                <Label text="💼 工作" style="-fx-font-size: 14px;"/>
                <Label text="兼职工资" style="-fx-text-fill: gray;"/>
                <Label text="+500.00" style="-fx-text-fill: green;"/>
            </HBox>
            <HBox style="-fx-border-color: gray; -fx-border-radius: 5px; -fx-padding: 10;" spacing="10">
                <Label text="🎁 其他" style="-fx-font-size: 14px;"/>
                <Label text="朋友转账" style="-fx-text-fill: gray;"/>
                <Label text="+200.00" style="-fx-text-fill: green;"/>
            </HBox>
        </FlowPane>
    </VBox>

</VBox>

