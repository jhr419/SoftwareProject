<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.shelton.ebu6403.controller.AnalysisController"
            stylesheets="@../styles/analysis.css">

    <top>
        <!-- 顶部标题 -->
        <Label text="Financial Analysis" styleClass="title-label"/>
    </top>

    <center>
        <VBox spacing="20">
            <!-- Daily Details 模块 -->
            <HBox spacing="20" styleClass="details-container">
                <!-- 左侧日历卡片 -->
                <VBox fx:id="calendarContainer" styleClass="calendar-card" prefWidth="350">
                    <!-- 日历内容由 Controller 生成 -->
                </VBox>

                <!-- 右侧交易明细 -->
                <VBox spacing="15" styleClass="transactions-container" HBox.hgrow="ALWAYS">
                    <!-- 顶部汇总卡片 -->
                    <HBox styleClass="summary-card">
                        <Label fx:id="summaryIncome" text="Income: $" styleClass="summary-income"/>
                        <Label fx:id="summarySpend" text="Spend: $" styleClass="summary-spend"/>
                        <Label fx:id="summaryBalance" text="Balance: $" styleClass="summary-balance"/>
                    </HBox>

                    <!-- 交易明细表格 -->
                    <TableView fx:id="transactionsTable" styleClass="transactions-table">
                        <columns>
                            <TableColumn text="Category" prefWidth="150"/>
                            <TableColumn text="Type" prefWidth="100"/>
                            <TableColumn text="Amount" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </HBox>

            <!-- Analysis 模块 -->
            <VBox spacing="15" styleClass="analysis-container">
                <!-- 选项卡 -->
                <TabPane fx:id="analysisTabs" styleClass="analysis-tabs">
                    <Tab text="Daily">
                        <VBox fx:id="analysisDailyPane" spacing="15"/>
                    </Tab>
                    <Tab text="Monthly">
                        <VBox fx:id="analysisMonthlyPane" spacing="15"/>
                    </Tab>
                    <Tab text="Year">
                        <VBox fx:id="analysisYearlyPane" spacing="15"/>
                    </Tab>
                </TabPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>

